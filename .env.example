# Smart Attendance System -- environment variables.
#
#   cp .env.example .env
#
# Every value below is optional except SECRET_KEY in production.  Defaults live in
# app/config.py; anything commented out here is showing you its default.
#
# This file is a template and must never hold a real secret -- .env itself is gitignored.

# ---------------------------------------------------------------------------------
# Flask core
# ---------------------------------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# Required in production: the app refuses to start without it rather than falling back
# to a hardcoded default.
SECRET_KEY=replace-me-with-a-generated-key

# development | testing | production
FLASK_ENV=development

# ---------------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------------
# Relative SQLite paths resolve inside instance/, so the default below is
# instance/attendance.db.  The PostgreSQL path is exercised in CI.
# DATABASE_URL=sqlite:///attendance.db
# DATABASE_URL=postgresql+psycopg://attendance:password@localhost:5432/attendance
#
# Used only by the test suite; unset means in-memory SQLite.
# TEST_DATABASE_URL=postgresql+psycopg://attendance:password@localhost:5432/attendance_test

# ---------------------------------------------------------------------------------
# Time
# ---------------------------------------------------------------------------------
# Timestamps are stored in UTC.  This IANA zone decides what "today" means and how
# times are rendered, so an evening mark does not land on the wrong date.
# APP_TIMEZONE=UTC
# APP_TIMEZONE=Asia/Kolkata

# A mark after this local time is recorded as "Late".
# LATE_THRESHOLD_TIME=09:30

# ---------------------------------------------------------------------------------
# Face detection (res10 SSD via cv2.dnn)
# ---------------------------------------------------------------------------------
# FACE_DETECTION_CONFIDENCE=0.6

# ---------------------------------------------------------------------------------
# Face recognition (LBPH)
# ---------------------------------------------------------------------------------
# LBPH returns a DISTANCE: lower is a better match.  A prediction above this is
# reported as Unknown.  Usable range is roughly 30-90; lower is stricter.
# FACE_MATCH_MAX_DISTANCE=70.0

# The best match must beat the runner-up by at least this much, otherwise it is
# ambiguous and rejected instead of guessed at.
# FACE_MATCH_MIN_MARGIN=8.0

# ---------------------------------------------------------------------------------
# Anti-proxy confirmation
# ---------------------------------------------------------------------------------
# Consecutive frames a student must be recognised in before auto-marking may write a
# record.  1 would let a single-frame false positive through; that is the whole point
# of this setting, so raise it rather than lower it.
# RECOGNITION_CONFIRM_FRAMES=5

# After a decision, ignore the same student for this long.
# RECOGNITION_COOLDOWN_SECONDS=60

# ---------------------------------------------------------------------------------
# Camera
# ---------------------------------------------------------------------------------
# CAMERA_INDEX=0
# CAMERA_WIDTH=640
# CAMERA_HEIGHT=480
# CAMERA_FPS=30

# ---------------------------------------------------------------------------------
# Export
# ---------------------------------------------------------------------------------
# Hard cap on the rows a single export may stream.
# EXPORT_MAX_ROWS=50000

# ---------------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------------
# memory:// is per-process, so behind more than one worker it silently does not limit.
# Point this at Redis in production.
# RATELIMIT_STORAGE_URI=memory://
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# ---------------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------------
# Rotating files under logs/.
# LOG_LEVEL=INFO

# ---------------------------------------------------------------------------------
# Gunicorn (production)
# ---------------------------------------------------------------------------------
# GUNICORN_BIND=0.0.0.0:5000
# GUNICORN_THREADS=4
# Long, because the MJPEG stream is a long-lived response.
# GUNICORN_TIMEOUT=120
# GUNICORN_LOG_LEVEL=info
#
# There is deliberately no GUNICORN_WORKERS: the camera is a single physical device and
# cannot be shared across processes.  See gunicorn.conf.py.
